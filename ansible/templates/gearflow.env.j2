COMPOSE_PROJECT_NAME=gearflow
DOCKER_NETWORK_NAME=gearflow
MYSQL_VOLUME_NAME=gearflow_mysql_data
MYSQL_DATABASE={{ vault_mysql_database | default('gearflow') }}
MYSQL_USER={{ vault_mysql_user }}
MYSQL_PASSWORD={{ vault_mysql_password }}
MYSQL_ROOT_PASSWORD={{ vault_mysql_root_password }}
JWT_SECRET={{ vault_jwt_secret }}
BACKEND_IMAGE={{ vault_dockerhub_username }}/gearflow-backend
FRONTEND_IMAGE={{ vault_dockerhub_username }}/gearflow-frontend
IMAGE_TAG={{ image_tag }}
EDGE_PORT=8081
