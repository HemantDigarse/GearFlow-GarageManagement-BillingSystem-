# ============================================================
# GearFlow - Terraform Variable Values
# ============================================================
# Copy this to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars to Git!
# ============================================================

aws_region    = "ap-south-1"
project_name  = "gearflow"
environment   = "production"

# Your public IP for SSH access (find at https://whatismyip.com)
# Add /32 at the end for a single IP
admin_cidr = "YOUR_IP_HERE/32"

# EC2 Configuration
instance_type    = "t3.small"
root_volume_size = 30

# SSH public key (output of: cat ~/.ssh/id_rsa.pub)
ssh_public_key = "ssh-rsa AAAA... your-key-here"

# RDS Configuration
db_instance_class    = "db.t3.micro"
db_name              = "gearflow"
db_username          = "gearflow_admin"
db_password          = "CHANGE_THIS_TO_A_STRONG_PASSWORD"
db_allocated_storage = 20

# Application
jwt_secret  = "CHANGE_THIS_TO_A_RANDOM_STRING_AT_LEAST_32_CHARACTERS_LONG"
domain_name = ""
