COMPOSE_PROJECT_NAME=gearflow
DOCKER_NETWORK_NAME=gearflow
MYSQL_VOLUME_NAME=gearflow_mysql_data
MYSQL_BIND_PORT=3307
MYSQL_DATABASE=gearflow
MYSQL_USER=gearflow
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
JWT_SECRET=replace-with-a-random-base64-key-at-least-32-bytes
BACKEND_IMAGE=gearflow-backend
FRONTEND_IMAGE=gearflow-frontend
IMAGE_TAG=latest
