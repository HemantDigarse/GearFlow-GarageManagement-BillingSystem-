# ============================================================
# GearFlow - Environment Variables Template
# Copy this to .env and fill in your values
# ============================================================

# --- Database ---
DB_ROOT_PASSWORD=your_root_password_here
DB_NAME=gearflow
DB_USER=gearflow_user
DB_PASSWORD=your_db_password_here

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long_change_this_in_production
JWT_EXPIRATION=86400000

# --- AWS (for production) ---
AWS_ACCOUNT_ID=123456789012
AWS_REGION=ap-south-1
RDS_ENDPOINT=your-rds-instance.xxxx.ap-south-1.rds.amazonaws.com
IMAGE_TAG=latest

# --- Spring ---
SPRING_PROFILE=prod
